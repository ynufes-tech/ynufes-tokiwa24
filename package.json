{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint --fix . && prettier --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@nuxtjs/google-fonts": "^3.2.0",
    "nuxt": "^4.6.4",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "packageManager": "pnpm@10.34.9",
  "devDependencies": {
    "@nuxt/eslint": "^0.6.0",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "nuxt-gtag": "^5.1.0",
    "prettier": "^3.3.3",
    "sass-embedded": "^1.86.3",
    "typescript": "5.5.4"
  },
  "lint-staged": {
    "*.{vue,ts}": "yarn run lint:fix"
  },
  "pnpm": {
    "overrides": {
      "minimatch@>=10 <11": "^11.0.1"
    }
  }
}
